/**
 * Example personal/local development configuration
 *
 * Instructions:
 * 1. Copy this file to wrangler.jsonc (for your personal deployment)
 * 2. Replace YOUR_KV_NAMESPACE_ID_HERE with your actual KV namespace ID
 * 3. Optionally change the name to avoid conflicts with others
 *
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "schwab-mcp-personal", // Change this to a unique name for your deployment
	"main": "src/index.ts",
	"compatibility_date": "2025-04-17",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1",
		},
		{
			"new_sqlite_classes": ["ProposalStore"],
			"tag": "v2",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT",
			},
			{
				"class_name": "ProposalStore",
				"name": "PROPOSAL_STORE",
			},
		],
	},
	// Drift-approval Slack integration (see docs/DRIFT_APPROVAL.md).
	// Secrets (wrangler secret put): SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET
	// Vars (or secrets): SLACK_CHANNEL_ID (C...), SLACK_APPROVER_IDS (U...,U...)
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "YOUR_KV_NAMESPACE_ID_HERE", // Replace with your actual KV namespace ID
		},
	],
	"observability": {
		"enabled": false, // Set to true for production monitoring (has costs)
	},
	"dev": {
		"port": 8788,
		"local_protocol": "http",
		"upstream_protocol": "https",
	},
	// OPTIONAL — a second Schwab LOGIN (a spouse's own credentials, not another
	// account on your login) must run as its own instance. Tokens are keyed by
	// schwabUserId, which rotates on every re-auth, so both the MCP session
	// loader and the orders path fall back to loadFreshest() — the newest
	// token:* key REGARDLESS OF OWNER. Two logins in one KV can therefore adopt
	// each other's tokens. Separate KV + persist dir is the isolation boundary.
	// See docs/SECOND_LOGIN.md. Run with `npm run dev:secondary`.
	"env": {
		"secondary": {
			"name": "schwab-mcp-secondary",
			// kv_namespaces and durable_objects are NOT inherited by
			// environments — they must be redeclared here.
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "YOUR_SECOND_KV_NAMESPACE_ID_HERE", // must differ from the one above
				},
			],
			"durable_objects": {
				"bindings": [
					{
						"class_name": "MyMCP",
						"name": "MCP_OBJECT",
					},
					{
						"class_name": "ProposalStore",
						"name": "PROPOSAL_STORE",
					},
				],
			},
		},
	},
}
